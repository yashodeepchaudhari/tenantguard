# Copy to .env. Brain and gateway run on the Docker laptop (Laptop A): put its IP here.
VITE_BRAIN_URL=http://127.0.0.1:8200
VITE_GATEWAY_URL=http://127.0.0.1:8000
VITE_LAB_URL=http://127.0.0.1:8300
# Gateway /admin/* needs X-TenantGuard-Control-Token = gateway env TENANTGUARD_CONTROL_TOKEN
VITE_CONTROL_TOKEN=dev
# 1 = built-in fixture replay, no backend needed (also: npm run dev:mock)
VITE_MOCK=0
# Tile colour thresholds for end-to-end p95 (ms) when the tenant itself is not flagged
VITE_P95_WARN_MS=150
VITE_P95_BAD_MS=400
# Fallback only when the brain's StateSnapshot.noisy_thresholds is empty
VITE_NOISY_WARN=1.5
VITE_NOISY_THROTTLE=2
VITE_NOISY_QUARANTINE=4
